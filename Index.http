<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1"><meta name="theme-color" content="#202c33"><title>ENS CONNECT 2026 - WhatsApp Clone</title>
<link rel="manifest" href="data:application/json;base64,eyJuYW1lIjoiRU5TIENPTk5FQ1QgMjAyNiIsInNob3J0X25hbWUiOiJFTlMgMjAyNiIsInN0YXJ0X3VybCI6Ii4iLCJkaXNwbGF5Ijoic3RhbmRhbG9uZSIsImJhY2tncm91bmRfY29sb3IiOiIjMTExYjIxIiwidGhlbWVfY29sb3IiOiIjMjAyYzMzIn0=">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}body{background:#111b21;color:#e9edef;font-family:system-ui;height:100vh;display:flex;flex-direction:column;overflow:hidden}
.header{background:#202c33;padding:14px 16px;display:flex;justify-content:space-between;align-items:center}
.tabs{display:flex;background:#202c33;border-bottom:1px solid #222d34}
.tab{flex:1;padding:14px;text-align:center;color:#8696a0;font-weight:500;font-size:14.5px;cursor:pointer}.tab.active{color:#00a884;border-bottom:3px solid #00a884}
.page{display:none;flex:1;overflow-y:auto;background:#111b21}.page.active{display:flex;flex-direction:column}
.chat{padding:11px 16px;display:flex;gap:12px;align-items:center;border-bottom:1px solid #1f2c34;cursor:pointer}.chat:active{background:#2a3942}
.av{width:49px;height:49px;border-radius:50%;background:linear-gradient(135deg,#00a884,#128c7e);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.mhead{background:#202c33;padding:8px 12px;display:flex;align-items:center;gap:10px}
#win{position:fixed;inset:0;background:#0b141a;z-index:99;display:none;flex-direction:column}
.msgs{flex:1;overflow-y:auto;padding:10px;background:#0b141a;background-image:url('https://user-images.githubusercontent.com/15075759/28719144-86dc0f70-73b1-11e7-911d-60d70fcded21.png')}
.bubble{max-width:78%;padding:7px 10px;border-radius:8px;margin:4px 0;font-size:14.5px;line-height:1.3;position:relative;box-shadow:0 1px 0.5px rgba(0,0,0,.3)}
.bubble.me{background:#005c4b;margin-left:auto;border-top-right-radius:0}.bubble.other{background:#202c33;border-top-left-radius:0}
.meta{font-size:11px;color:#8696a0;text-align:right;margin-top:3px;display:flex;justify-content:flex-end;gap:4px;align-items:center}
.tick{color:#53bdeb}
.inputbar{background:#202c33;padding:6px 8px;display:flex;align-items:flex-end;gap:6px}
.inputbar.inpwrap{flex:1;background:#2a3942;border-radius:20px;display:flex;align-items:flex-end;padding:5px 12px}
.inputbar input,.inputbar textarea{flex:1;background:transparent;border:0;color:#fff;outline:0;font-size:15px;resize:none;max-height:100px;padding:7px 0}
.iconbtn{width:44px;height:44px;border-radius:50%;border:0;background:#00a884;color:#fff;font-size:20px;display:flex;align-items:center;justify-content:center}
.statusAdd{margin:12px 16px;padding:12px;background:#202c33;border-radius:12px;display:flex;gap:12px;align-items:center}
.fab{position:fixed;bottom:20px;right:20px;width:56px;height:56px;background:#00a884;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26px;box-shadow:0 4px 8px rgba(0,0,0,.3);z-index:5}
</style></head><body>
<div class="header"><div><b style="font-size:19px">ENS CONNECT 2026</b></div><div style="display:flex;gap:18px;font-size:20px"><span onclick="alert('📞 Free calls: Share link '+location.href)">📞</span><span>🔍</span><span>⋮</span></div></div>
<div class="tabs"><div class="tab active" id="t1" onclick="switchTab('chats')">CHATS</div><div class="tab" id="t2" onclick="switchTab('status')">STATUS</div><div class="tab" id="t3" onclick="switchTab('calls')">CALLS</div></div>

<div id="pg-chats" class="page active" style="display:flex">
<div class="chat" onclick="openChat('ENS 2026 Official Group 👥','group')"><div class="av">👥</div><div style="flex:1;overflow:hidden"><b>ENS 2026 Official Group 💬</b><br><small style="color:#8696a0">Amos: CAT tomorrow 9am 📚 • 24 new</small></div><div style="text-align:right"><small style="color:#00a884">05:55</small><br><span style="background:#00a884;color:#000;font-size:11px;padding:2px 6px;border-radius:10px">24</span></div></div>
<div class="chat" onclick="openChat('Dr Okore (Patron)','private')"><div class="av">👨‍🏫</div><div style="flex:1"><b>Dr Okore (Patron)</b><br><small style="color:#00a884">✓✓ Assignment received - 05:20</small></div><small style="color:#8696a0">Yesterday</small></div>
<div class="chat" onclick="openChat('Class Rep Amos','private')"><div class="av">🎓</div><div style="flex:1"><b>Class Rep - Amos Nyongesa</b><br><small style="color:#8696a0">🎙️ Voice message • 0:24</small></div><small style="color:#8696a0">Yesterday</small></div>
<div class="chat" onclick="openChat('ENS 582 Materials','group')"><div class="av">📚</div><div style="flex:1"><b>ENS 582 Materials</b><br><small style="color:#8696a0">sciencee962@gmail.com: Notes PDF 📄</small></div><small style="color:#8696a0">Today</small></div>
</div>

<div id="pg-status" class="page">
<div class="statusAdd" onclick="document.getElementById('fileStatus').click()"><div class="av" style="width:46px;height:46px">➕</div><div><b>My status</b><br><small style="color:#8696a0">Tap to add photo/video (24h)</small></div></div>
<input type="file" id="fileStatus" accept="image/*,video/*" hidden onchange="addStatus(this)">
<div style="padding:8px 16px;background:#182229;color:#8696a0;font-size:12px;letter-spacing:.5px">RECENT UPDATES</div>
<div id="statusList">
<div class="chat" onclick="viewStatus('Dr Okore','Exam on Friday!')"><div class="av" style="border:3px solid #00a884">👨‍🏫</div><div><b>Dr Okore</b><br><small style="color:#8696a0">Today, 05:10</small></div></div>
<div class="chat" onclick="viewStatus('Amos','Library 8am')"><div class="av" style="border:3px solid #00a884">🎓</div><div><b>Class Rep Amos</b><br><small style="color:#8696a0">Today, 06:00</small></div></div>
</div>
</div>

<div id="pg-calls" class="page">
<div id="callList">
<div class="chat" onclick="makeCall('Dr Okore')"><div class="av">👨‍🏫</div><div style="flex:1"><b>Dr Okore (Patron)</b><br><small style="color:#f15c6d">↙ Missed • Yesterday, 10:30 AM</small></div><div style="color:#00a884;font-size:22px">📞</div></div>
<div class="chat" onclick="makeCall('Amos')"><div class="av">🎓</div><div style="flex:1"><b>Class Rep Amos</b><br><small style="color:#00a884">↗ Outgoing • Yesterday, 9:15 AM</small></div><div style="color:#00a884;font-size:22px">📹</div></div>
</div>
<div style="padding:16px"><button onclick="makeCall('ENS Group')" style="width:100%;padding:14px;background:#00a884;border:0;border-radius:12px;color:#fff;font-weight:700;font-size:15px">📞 Start Free ENS Group Call</button><p style="font-size:11px;color:#8696a0;text-align:center;margin-top:10px">Free via WiFi/Data - No airtime. Share link to join: <br><b style="color:#53bdeb">{{LINK}}</b></p></div>
</div>

<div class="fab" onclick="newChat()">💬</div>

<div id="win">
<div class="mhead"><span onclick="closeChat()" style="font-size:26px;padding:4px 8px 4px 0">←</span><div class="av" style="width:38px;height:38px;font-size:16px" id="chatAv">👥</div><div style="flex:1"><b id="chatName">Group</b><br><small id="chatSub" style="color:#8696a0">tap here for group info</small></div><div style="display:flex;gap:16px;font-size:20px"><span onclick="makeCall(document.getElementById('chatName').innerText)">📞</span><span onclick="makeCall(document.getElementById('chatName').innerText,true)">📹</span><span>⋮</span></div></div>
<div class="msgs" id="msgBox"><div class="bubble other">Welcome to ENS CONNECT 2026 WhatsApp Clone! 🎉<div class="meta">05:55 AM</div></div><div class="bubble other">Patron Dr Okore: Karibu to official communication platform. No more missing CATs! 📚<div class="meta">05:56 AM <span class="tick">✓✓</span></div></div></div>
<div id="typing" style="padding:0 16px 4px;color:#00a884;font-size:12px;display:none">Amos is typing...</div>
<div class="inputbar">
<div class="inpwrap"><span style="font-size:22px;padding-right:8px" onclick="document.getElementById('emojiBox').style.display=document.getElementById('emojiBox').style.display=='flex'?'none':'flex'">😊</span><textarea id="txt" rows="1" placeholder="Message" oninput="this.style.height='auto';this.style.height=this.scrollHeight+'px';typingOn()" onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendMsg()}"></textarea><span style="font-size:22px;padding-left:8px" onclick="document.getElementById('fileAttach').click()">📎</span></div>
<button class="iconbtn" id="sendBtn" onclick="handleSend()">➤</button>
<input type="file" id="fileAttach" hidden accept="image/*,video/*,.pdf,.doc,.docx" onchange="sendFile(this)">
</div>
<div id="emojiBox" style="display:none;padding:8px;background:#202c33;flex-wrap:wrap;gap:8px;font-size:24px"><span onclick="addEmoji('😂')">😂</span><span onclick="addEmoji('❤️')">❤️</span><span onclick="addEmoji('🔥')">🔥</span><span onclick="addEmoji('📚')">📚</span><span onclick="addEmoji('✅')">✅</span><span onclick="addEmoji('👏')">👏</span><span onclick="addEmoji('🎓')">🎓</span><span onclick="addEmoji('💯')">💯</span></div>
</div>

<script>
let chats={};let isRecording=false;let recorder;
function switchTab(t){document.querySelectorAll('.page').forEach(p=>{p.classList.remove('active');p.style.display='none'});document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));let pg=document.getElementById('pg-'+t);pg.classList.add('active');pg.style.display='flex';document.getElementById(t=='chats'?'t1':t=='status'?'t2':'t3').classList.add('active')}
let curChat='';
function openChat(name,type){curChat=name;document.getElementById('win').style.display='flex';document.getElementById('chatName').innerText=name;document.getElementById('chatSub').innerText=type=='group'? '24 participants, 5 online':'online';document.getElementById('chatAv').innerText=type=='group'?'👥':'👤';setTimeout(()=>{document.getElementById('msgBox').scrollTop=99999},100)}
function closeChat(){document.getElementById('win').style.display='none'}
function sendMsg(){let i=document.getElementById('txt');let v=i.value.trim();if(!v)return;let b=document.getElementById('msgBox');let d=document.createElement('div');d.className='bubble me';d.innerHTML=v.replace(/\n/g,'<br>')+'<div class=meta>'+new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})+' <span class=tick>✓✓</span></div>';b.appendChild(d);b.scrollTop=b.scrollHeight;i.value='';i.style.height='auto';hideTyping();saveMsg(curChat,v);setTimeout(()=>autoReply(),1000+Math.random()*1000)}
function autoReply(){let r=["Sawa 👊","Noted ✅","Thanks for update","Meeting at 8am?","PDF iko? 📄","Seen ✓✓"];let b=document.getElementById('msgBox');let d=document.createElement('div');d.className='bubble other';d.innerHTML=r[Math.floor(Math.random()*r.length)]+'<div class=meta>'+new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})+'</div>';b.appendChild(d);b.scrollTop=b.scrollHeight}
function addEmoji(e){document.getElementById('txt').value+=e;document.getElementById('txt').focus()}
function handleSend(){let t=document.getElementById('txt').value.trim();if(t){sendMsg()}else{toggleVoice()}}
async function toggleVoice(){let btn=document.getElementById('sendBtn');if(!isRecording){try{let s=await navigator.mediaDevices.getUserMedia({audio:true});recorder=new MediaRecorder(s);let chunks=[];recorder.ondataavailable=e=>chunks.push(e.data);recorder.onstop=()=>{let blob=new Blob(chunks,{type:'audio/ogg'});let url=URL.createObjectURL(blob);let b=document.getElementById('msgBox');let d=document.createElement('div');d.className='bubble me';d.innerHTML='🎙️ Voice message 0:'+Math.floor(Math.random()*30+2)+'s <audio controls src='+url+' style=width:160px></audio><div class=meta>'+new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})+' <span class=tick>✓✓</span></div>';b.appendChild(d);b.scrollTop=b.scrollHeight};recorder.start();isRecording=true;btn.innerText='■';btn.style.background='#f15c6d'}catch(e){alert('Mic permission needed for voice notes')}}else{recorder.stop();isRecording=false;btn.innerText='➤';btn.style.background='#00a884'}}
function sendFile(input){let f=input.files[0];if(!f)return;let b=document.getElementById('msgBox');let d=document.createElement('div');d.className='bubble me';let icon=f.type.startsWith('image/')?'🖼️ Photo':f.type.startsWith('video/')?'🎥 Video':'📄 Document';d.innerHTML=icon+'<br><b>'+f.name+'</b> ('+(f.size/1024).toFixed(0)+' KB)<div class=meta>'+new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})+' <span class=tick>✓✓</span></div>';b.appendChild(d);b.scrollTop=b.scrollHeight;if(f.type.startsWith('image/')){let rd=new FileReader();rd.onload=e=>{let dd=document.createElement('div');dd.className='bubble me';dd.innerHTML='<img src='+e.target.result+' style=max-width:100%;border-radius:8px><div class=meta>'+new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})+' <span class=tick>✓✓</span></div>';b.appendChild(dd);b.scrollTop=b.scrollHeight};rd.readAsDataURL(f)}}
function makeCall(name,isVideo){let room='ENS2026_'+encodeURIComponent(name)+'_'+Date.now();let url='https://meet.jit.si/'+room;if(confirm((isVideo?'📹 Video':'📞 Voice')+' Call '+name+'?\n\nFree call - Click OK to join call room.\nShare link for them to join:\n'+url)){window.open(url,'_blank')}}
function addStatus(input){let f=input.files[0];if(!f)return;let list=document.getElementById('statusList');let div=document.createElement('div');div.className='chat';div.innerHTML='<div class=av style=border:3px solid #00a884>👤</div><div><b>My Status</b><br><small style=color:#8696a0>Just now • Tap to view</small></div>';div.onclick=()=>alert('Status: '+f.name+' - Visible for 24h to all ENS 2026');list.prepend(div);alert('✅ Status added! Visible to all classmates for 24h like WhatsApp')}
function viewStatus(name,text){alert('📸 Status by '+name+':\n\n'+text+'\n\n(24h story - WhatsApp style)')}
function newChat(){let n=prompt('Enter ENS student name or admission number:','ENS/');if(n){openChat(n,'private')}}
function typingOn(){let t=document.getElementById('typing');t.style.display='block';clearTimeout(window.typTO);window.typTO=setTimeout(()=>t.style.display='none',1500)}
function hideTyping(){document.getElementById('typing').style.display='none'}
function saveMsg(chat,txt){let all=JSON.parse(localStorage.getItem('ens_msgs')||'{}');if(!all[chat])all[chat]=[];all[chat].push({txt,time:Date.now()});localStorage.setItem('ens_msgs',JSON.stringify(all))}
window.addEventListener('load',()=>{document.body.innerHTML=document.body.innerHTML.replace('{{LINK}}',location.href)})
</script>
</body></html>
